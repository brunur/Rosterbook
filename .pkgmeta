# BigWigs packager settings for the in-game add-on (see release-addon.yml).
# The repository also holds the desktop app; only the two add-on folders ship.
package-as: Rosterbook

move-folders:
  Rosterbook/addon/Rosterbook: Rosterbook
  Rosterbook/addon/Rosterbook_UI: Rosterbook_UI

ignore:
  - .github
  - addon/test
  - app
  - crates
  - dev
  - ui
  - Cargo.toml
  - Cargo.lock
  - README.md
  - LICENSE
  - PRIVACY.md

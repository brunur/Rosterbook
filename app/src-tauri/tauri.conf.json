{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RosterBook",
  "mainBinaryName": "rosterbook",
  "identifier": "net.rosterbook.desktop",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "See your World of Warcraft characters on any screen.",
    "longDescription": "RosterBook reads what its in-game add-on saves and shows your characters' gold, bags, bank, gear, reputation and rested XP on this PC and on phones or tablets on your home network.",
    "copyright": "© 2026 Bob. All rights reserved. RosterBook is not affiliated with or endorsed by Blizzard Entertainment.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] },
      "rpm": { "depends": ["libayatana-appindicator-gtk3"] }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/Brunur/Rosterbook/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
